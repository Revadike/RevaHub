{
  "name": "revahub",
  "version": "0.1.0",
  "description": "A self-hosted, event-driven automation platform with a plugin-based module and task ecosystem",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "revahub",
    "automation",
    "self-hosted",
    "event-driven"
  ],
  "bin": {
    "revahub": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run copy:migrations",
    "copy:migrations": "node -e \"const{cpSync}=require('fs');cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "build:ui": "cd ui && node node_modules/vite/bin/vite.js build --outDir ../dist/ui",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.2",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.3.3",
    "node-cron": "^3.0.3",
    "pg": "^8.14.1",
    "revahub-module-database": "*",
    "revahub-module-logger": "*",
    "revahub-task-cleanup-logs": "*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.0"
  }
}