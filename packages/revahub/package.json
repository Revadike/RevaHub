{
  "name": "revahub",
  "version": "0.1.0",
  "description": "A self-hosted, event-driven automation platform with a plugin-based module and task ecosystem",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "revahub",
    "automation",
    "self-hosted",
    "event-driven"
  ],
  "bin": {
    "revahub": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run copy:migrations && npm run build:ui",
    "build:ui": "npm run build -w revahub-ui && node -e \"const{cpSync}=require('fs');cpSync('../revahub-ui/dist','dist/ui',{recursive:true})\"",
    "copy:migrations": "node -e \"const{cpSync}=require('fs');cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.2",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.3.3",
    "node-cron": "^3.0.3",
    "revahub-module-database": "*",
    "revahub-module-logger": "*",
    "revahub-task-cleanup-logs": "*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.0",
    "revahub-types": "*",
    "tsx": "^4.21.0"
  }
}