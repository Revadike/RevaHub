{
  "name": "revahub-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build -w revahub-types",
    "build": "npm run build --workspaces",
    "build:ui": "npm run build:ui -w revahub",
    "dev": "concurrently -k -n api,ui \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "npm run dev -w revahub",
    "dev:ui": "npm run dev -w revahub-ui",
    "start": "node packages/revahub/dist/cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@types/node": "^22.19.15",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-vue": "^9.33.0",
    "eslint-plugin-vuetify": "^2.5.3",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}