{
  "name": "revahub-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:ui": "npm run build:ui -w packages/revahub",
    "dev": "npm run dev -w packages/revahub",
    "start": "node packages/revahub/dist/cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.28.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-vue": "^10.1.0",
    "eslint-plugin-vuetify": "^2.5.1",
    "globals": "^16.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.1"
  }
}
